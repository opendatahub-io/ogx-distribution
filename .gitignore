# Prefetched modelcar /models tree staged into the build context by CI
# (actions/cache); never committed. The .gitkeep is kept so the directory always
# exists as a COPY source for the Containerfile's cache mode.
distribution/artifact-cache/models/*
!distribution/artifact-cache/models/.gitkeep
